{
  "name": "@thesis/agent",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "mint": "node --env-file=../.env --import tsx src/mint.ts",
    "resolve": "node --env-file=../.env --import tsx src/resolve.ts",
    "research": "node --env-file=../.env --import tsx src/research.ts"
  },
  "dependencies": {
    "@thesis/shared": "workspace:*",
    "viem": "^2.45.0"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "@types/node": "^22.9.0"
  }
}
