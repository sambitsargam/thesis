# X Layer RPC — mainnet chain 196, testnet chain 195
XLAYER_RPC_URL=
XLAYER_TESTNET_RPC_URL=

# Throwaway deployment wallet. Funded with OKB only. Never commit a real key.
DEPLOYER_PRIVATE_KEY=

# OKLink contract verification
OKLINK_API_KEY=

# OKX Onchain OS / Trade credentials (Developer Portal)
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
OKX_PROJECT_ID=

# X Layer Builder Code from the OKX developer portal (16 characters).
# Public identifier, not a secret. NEXT_PUBLIC_ copy is needed by the web app.
BUILDER_CODE=
NEXT_PUBLIC_BUILDER_CODE=

# Agent worker
DATABASE_URL=
AGENT_PORT=8787

# Deployment inputs for script/DeployThesis.s.sol (all required except the demo basket)
QUOTE_TOKEN=
TRADE_ROUTER=
AGENT_ADDRESS=

# Leave DEMO_CONSTITUENTS empty to deploy the factory alone
DEMO_CONSTITUENTS=
DEMO_NAME=Thesis Semiconductors
DEMO_SYMBOL=THESIS-SEMI
DEMO_THEME=semiconductor supply chain, equal weight

# OKX Onchain OS Trade contracts on X Layer (196). Leave TRADE_ROUTER empty to deploy
# a fresh OkxTradeRouter adapter bound to these.
OKX_DEX_ROUTER=0x7c5bee2a8091c3ef39072f64f18fac913060aeaf
OKX_TOKEN_APPROVE=0x8b773D83bc66Be128c60e07E17C8901f7a64F000

# ThesisZap — optional sell-to-USD-T0 helper. Leave empty to keep redeem in kind only.
# Either name works; the plain one is read at runtime so it needs no rebuild.
ZAP_ADDRESS=
NEXT_PUBLIC_ZAP_ADDRESS=

# OpenAI key for resolving a plain-language theme into constituents.
# Server-side only; the model never sees a wallet or a key of yours.
OPENAI_API=
OPENAI_MODEL=gpt-4o-mini
# Model used for the web-search research pass.
OPENAI_SEARCH_MODEL=gpt-4o
