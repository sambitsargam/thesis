{
  "name": "thesis",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Permissionless index launchpad for tokenized equities on X Layer",
  "packageManager": "pnpm@8.15.4",
  "scripts": {
    "build": "pnpm --filter @thesis/web build",
    "typecheck": "pnpm -r typecheck",
    "test:contracts": "forge test --root contracts",
    "build:contracts": "forge build --root contracts",
    "fmt:contracts": "forge fmt --root contracts",
    "check": "pnpm build:contracts && pnpm test:contracts && pnpm typecheck",
    "build:all": "pnpm -r build",
    "demo:narrate": "node --env-file=.env --import tsx demo/narrate.ts",
    "demo:record": "node --env-file=.env --import tsx demo/record.ts",
    "demo:browser": "node --env-file=.env --import tsx demo/open-browser.ts",
    "demo:screen": "node --env-file=.env --import tsx demo/screen.ts",
    "demo:mux": "node --import tsx demo/mux.ts",
    "demo:preflight": "node --env-file=.env --import tsx demo/preflight.ts"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "playwright": "^1.63.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "viem": "^2.45.0",
    "@thesis/shared": "workspace:*"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
